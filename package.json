{
  "name": "new-package",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "lint:format": "oxfmt --check",
    "format": "oxfmt",
    "types:check": "turbo run types:check",
    "test": "vitest",
    "test:rust": "cargo test -p fuma-translate-native",
    "bench:rust": "cargo test --release -p fuma-translate-native bench -- --ignored --nocapture",
    "tegami": "node scripts/tegami.mts"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.68.0",
    "tegami": "^0.1.0-beta.4",
    "tinyexec": "^1.2.4",
    "turbo": "^2.9.18",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2"
}
